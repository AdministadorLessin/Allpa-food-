# Config de referencia para allpafood.com — NO se carga automáticamente.
# Nginx no soporta un archivo tipo .htaccess por carpeta: hay que copiar
# estas líneas dentro del bloque `server { }` ya existente que sirve este
# directorio (Landing/) como root, y luego recargar el servicio:
#
#   sudo nginx -t && sudo systemctl reload nginx
#
# Ajusta `root` a la ruta real del directorio Landing/ en el servidor.

server {
    # ... listen, server_name, ssl_certificate, etc. (config existente) ...

    root /ruta/real/a/Landing;
    index index.html;

    # --- 301: URLs viejas con .html redirigen a las URLs limpias ---
    location = /index.html      { return 301 /; }
    location = /beneficios.html { return 301 /beneficios; }
    location = /recetas.html    { return 301 /recetas; }
    location = /allpaplus.html  { return 301 /allpaplus; }

    # --- Sirve la URL limpia probando el archivo .html correspondiente ---
    location / {
        try_files $uri $uri.html $uri/ =404;
    }

    # ... resto de la config existente ...
}
